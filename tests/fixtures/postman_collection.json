{
  "info": {
    "name": "Enterprise Petstore Collection",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{petstoreToken}}",
        "type": "string"
      }
    ]
  },
  "item": [
    {
      "name": "Pets",
      "item": [
        {
          "name": "List pets",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/pets?limit={{limit}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('status is 200', function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Rotate token",
          "request": {
            "method": "POST",
            "url": "https://api.petstore.example.com/admin/token",
            "auth": {
              "type": "apikey",
              "apikey": [
                {
                  "key": "value",
                  "value": "sk_live_1234567890abcdef",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('rotated', true);"
                ]
              }
            }
          ]
        }
      ]
    }
  ]
}
