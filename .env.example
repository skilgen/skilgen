# Self-hosted root environment file used by Docker Compose and local container runs.

# -- Database / cache ------------------
DATABASE_URL=postgresql+asyncpg://skillayer:change-me@postgres:5432/skillayer
POSTGRES_PASSWORD=change-me
REDIS_URL=redis://redis:6379/0

# -- Deployment mode -------------------
# Options: saas | selfhosted | development
DEPLOYMENT_MODE=selfhosted

# -- Public app URLs -------------------
NEXT_PUBLIC_DASHBOARD_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
API_URL=http://localhost:8000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -- GitHub App ------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# -- WorkOS ----------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=http://localhost:3000/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=http://localhost:3000/callback
WORKOS_COOKIE_PASSWORD=replace-with-a-32-character-secret

# -- Optional self-hosted OIDC ---------
OIDC_ISSUER_URL=
OIDC_AUDIENCE=
OIDC_JWKS_URI=

# -- Optional SaaS queue keys ----------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# -- Optional admin / observability ----
ADMIN_SECRET=
CRON_SECRET=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
