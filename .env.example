# -- Database --------------------------
DATABASE_URL=postgresql+asyncpg://user:pass@host/db

# -- GitHub App ------------------------
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# -- WorkOS ----------------------------
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
WORKOS_REDIRECT_URI=https://app.skillayer.com/callback
NEXT_PUBLIC_WORKOS_REDIRECT_URI=https://app.skillayer.com/callback
WORKOS_COOKIE_PASSWORD=

# -- Self-hosted OIDC ------------------
OIDC_ISSUER_URL=https://your-company.okta.com
OIDC_AUDIENCE=skillayer
OIDC_JWKS_URI=

# -- Queue (SaaS mode) -----------------
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# -- Queue (self-hosted mode) ----------
REDIS_URL=redis://localhost:6379/0

# -- App URLs --------------------------
NEXT_PUBLIC_APP_URL=https://skillayer.com
NEXT_PUBLIC_DASHBOARD_URL=https://app.skillayer.com
NEXT_PUBLIC_API_URL=https://api.skillayer.com

# -- Deployment ------------------------
# Options: saas | selfhosted | development
DEPLOYMENT_MODE=development

# -- Observability ---------------------
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com
